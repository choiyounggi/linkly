{
  "lir_version": "0.1",
  "module": "payment-refund",
  "nodes": [
    {
      "kind": "Service",
      "id": "svc.payment",
      "name": "PaymentService",
      "requires": [
        "cap.postgres",
        "cap.jwt"
      ],
      "constraints": [
        "policy.payment",
        "security.payment"
      ],
      "children": [
        "wf.approval",
        "wf.refund.request"
      ]
    },
    {
      "kind": "Entity",
      "id": "entity.payment",
      "name": "Payment",
      "fields": [
        {
          "name": "id",
          "type": "UUID"
        },
        {
          "name": "cardNumber",
          "type": "Password"
        },
        {
          "name": "amountCents",
          "type": "Integer"
        },
        {
          "name": "createdAt",
          "type": "DateTime"
        }
      ]
    },
    {
      "kind": "Entity",
      "id": "entity.refund",
      "name": "Refund",
      "fields": [
        {
          "name": "id",
          "type": "UUID"
        },
        {
          "name": "paymentId",
          "type": "UUID"
        },
        {
          "name": "amountCents",
          "type": "Integer"
        },
        {
          "name": "requestedAt",
          "type": "DateTime"
        }
      ]
    },
    {
      "kind": "Event",
      "id": "event.refund.issued",
      "name": "RefundIssued",
      "source": {
        "ref": "entity.refund",
        "on": "create"
      }
    },
    {
      "kind": "Workflow",
      "id": "wf.approval",
      "name": "Approval",
      "children": [
        "wf.approval.guard.1"
      ]
    },
    {
      "kind": "WorkflowStep",
      "id": "wf.approval.step.1",
      "name": "create payment",
      "children": [
        "wf.approval.step.1.repo"
      ]
    },
    {
      "kind": "RepositoryCall",
      "id": "wf.approval.step.1.repo",
      "entity": "entity.payment",
      "operation": "create"
    },
    {
      "kind": "Guard",
      "id": "wf.approval.guard.1",
      "children": [
        "wf.approval.step.1"
      ],
      "mode": "when",
      "condition": "input.amountCents > 0 and input.amountCents <= 1000000"
    },
    {
      "kind": "Workflow",
      "id": "wf.refund.request",
      "name": "RefundRequest",
      "children": [
        "wf.refund.request.step.1",
        "wf.refund.request.guard.1"
      ]
    },
    {
      "kind": "WorkflowStep",
      "id": "wf.refund.request.step.1",
      "name": "read payment",
      "children": [
        "wf.refund.request.step.1.repo"
      ]
    },
    {
      "kind": "RepositoryCall",
      "id": "wf.refund.request.step.1.repo",
      "entity": "entity.payment",
      "operation": "read"
    },
    {
      "kind": "WorkflowStep",
      "id": "wf.refund.request.step.2",
      "name": "create refund",
      "children": [
        "wf.refund.request.step.2.repo"
      ]
    },
    {
      "kind": "RepositoryCall",
      "id": "wf.refund.request.step.2.repo",
      "entity": "entity.refund",
      "operation": "create"
    },
    {
      "kind": "Guard",
      "id": "wf.refund.request.guard.1",
      "children": [
        "wf.refund.request.step.2"
      ],
      "mode": "when",
      "condition": "input.requestedAt - payment.createdAt <= 30d and input.amountCents <= payment.amountCents"
    },
    {
      "kind": "Policy",
      "id": "policy.payment",
      "rules": [
        {
          "name": "retry",
          "value": 2
        },
        {
          "name": "timeout",
          "value": "3s"
        }
      ]
    },
    {
      "kind": "Security",
      "id": "security.payment",
      "mechanisms": [
        "jwt",
        "encrypt cardNumber"
      ]
    },
    {
      "kind": "Capability",
      "id": "cap.postgres",
      "name": "postgres"
    },
    {
      "kind": "Capability",
      "id": "cap.jwt",
      "name": "jwt"
    }
  ]
}
