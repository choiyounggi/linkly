    "/orders-service/create-order": {
      "post": {
        "operationId": "orders_service_create_order",
        "summary": "CreateOrder workflow",
        "description": "Steps: validate order -> list customer where id == input.customer -> list catalogproduct where id == input.product -> list stock where id == input.product and onHand >= input.qty -> create order as newOrder -> set newOrder.status to 0 -> set newOrder.customerTier to max customer.tier -> set newOrder.stockOnHand to max stock.onHand -> create orderline as line -> set line.unitPriceCents to max product.priceCents -> set line.lineTotalCents to line.unitPriceCents * line.qty -> create stockreservation as reservation -> set newOrder.subtotalCents to line.lineTotalCents -> set newOrder.discountCents to newOrder.subtotalCents * 10 -> set newOrder.discountCents to newOrder.discountCents / 100 -> set newOrder.discountCents to newOrder.discountCents * newOrder.customerTier -> set newOrder.taxCents to newOrder.subtotalCents - newOrder.discountCents -> set newOrder.taxCents to newOrder.taxCents * 8 -> set newOrder.taxCents to newOrder.taxCents / 100 -> set newOrder.totalCents to newOrder.subtotalCents - newOrder.discountCents -> set newOrder.totalCents to newOrder.totalCents + newOrder.taxCents -> find order -> respond order.id order.status order.subtotalCents order.discountCents order.taxCents order.totalCents",
