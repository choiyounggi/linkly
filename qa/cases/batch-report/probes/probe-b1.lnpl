# probe-b1 — H-b1: 그럴듯한 스케줄 스텝(schedule)은 no-op인가
# 변수 1개: VERB_LEXICON 밖 동사 `schedule` 스텝 1개.
# 예측: compile exit 0 + unknown-verb 1건, IR Effect 없음, mode A 완주.

capability postgres

entity Report
    field
        id UUID
        reportDate DateTime
        orderCount Integer
        totalAmount Money

workflow NightlyBatch
    validate report
    schedule daily at midnight
    create report
