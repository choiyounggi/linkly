{
  "lir_version": "0.1",
  "module": "login",
  "nodes": [
    {
      "kind": "Service",
      "id": "svc.login",
      "name": "LoginService",
      "requires": [
        "cap.postgres",
        "cap.redis",
        "cap.jwt"
      ],
      "constraints": [
        "policy.login",
        "security.login",
        "perf.login"
      ],
      "children": [
        "wf.login"
      ]
    },
    {
      "kind": "Entity",
      "id": "entity.user",
      "name": "User",
      "fields": [
        {
          "name": "id",
          "type": "UUID"
        },
        {
          "name": "email",
          "type": "Email"
        },
        {
          "name": "password",
          "type": "Password"
        },
        {
          "name": "createdAt",
          "type": "DateTime"
        }
      ]
    },
    {
      "kind": "Event",
      "id": "event.user.created",
      "name": "UserCreated",
      "source": {
        "ref": "entity.user",
        "on": "create"
      }
    },
    {
      "kind": "Workflow",
      "id": "wf.login",
      "name": "Login",
      "children": [
        "wf.login.step.1",
        "wf.login.step.2",
        "wf.login.step.3",
        "wf.login.step.4",
        "wf.login.step.5",
        "wf.login.step.6"
      ]
    },
    {
      "kind": "WorkflowStep",
      "id": "wf.login.step.1",
      "name": "validate input",
      "children": [
        "wf.login.step.1.check"
      ]
    },
    {
      "kind": "Validation",
      "id": "wf.login.step.1.check",
      "target": "entity.user",
      "rule": "semantic-types"
    },
    {
      "kind": "WorkflowStep",
      "id": "wf.login.step.2",
      "name": "authenticate",
      "children": [
        "wf.login.step.2.repo"
      ]
    },
    {
      "kind": "RepositoryCall",
      "id": "wf.login.step.2.repo",
      "entity": "entity.user",
      "operation": "read"
    },
    {
      "kind": "WorkflowStep",
      "id": "wf.login.step.3",
      "name": "cache user",
      "children": [
        "wf.login.step.3.cache"
      ]
    },
    {
      "kind": "CacheAccess",
      "id": "wf.login.step.3.cache",
      "key": "user:{id}",
      "operation": "set"
    },
    {
      "kind": "WorkflowStep",
      "id": "wf.login.step.4",
      "name": "generate token"
    },
    {
      "kind": "WorkflowStep",
      "id": "wf.login.step.5",
      "name": "audit login"
    },
    {
      "kind": "WorkflowStep",
      "id": "wf.login.step.6",
      "name": "return token"
    },
    {
      "kind": "Policy",
      "id": "policy.login",
      "rules": [
        {
          "name": "retry",
          "value": 3
        },
        {
          "name": "rollback"
        },
        {
          "name": "timeout",
          "value": "3s"
        }
      ]
    },
    {
      "kind": "Security",
      "id": "security.login",
      "mechanisms": [
        "jwt"
      ]
    },
    {
      "kind": "Performance",
      "id": "perf.login",
      "budgets": [
        {
          "metric": "response",
          "value": "<50ms"
        },
        {
          "metric": "cache",
          "value": "5m"
        }
      ]
    },
    {
      "kind": "Capability",
      "id": "cap.postgres",
      "name": "postgres"
    },
    {
      "kind": "Capability",
      "id": "cap.redis",
      "name": "redis"
    },
    {
      "kind": "Capability",
      "id": "cap.jwt",
      "name": "jwt"
    }
  ]
}
