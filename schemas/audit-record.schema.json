{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lnpl audit record (issue #241)",
  "type": "object",
  "required": ["record_type", "schema_version", "timestamp", "correlation_id",
               "trace_id", "span_id", "actor", "action", "resource", "outcome",
               "duration_ms"],
  "additionalProperties": false,
  "properties": {
    "record_type": {"const": "lnpl.audit"},
    "schema_version": {"const": 1},
    "timestamp": {"type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "correlation_id": {"type": ["string", "null"]},
    "trace_id": {"type": ["string", "null"]},
    "span_id": {"type": ["string", "null"]},
    "actor": {"oneOf": [
      {"type": "null"},
      {"type": "object", "required": ["subject", "role"], "additionalProperties": false,
       "properties": {"subject": {"type": ["string", "null"]},
                      "role": {"type": ["string", "null"]}}}]},
    "action": {"type": "object", "required": ["method", "route", "kind", "workflow"],
               "additionalProperties": false,
               "properties": {"method": {"type": "string", "minLength": 1},
                              "route": {"type": "string", "minLength": 1},
                              "kind": {"type": ["string", "null"]},
                              "workflow": {"type": ["string", "null"]}}},
    "resource": {"type": "array",
                 "items": {"type": "object", "required": ["entity", "op", "key"],
                           "additionalProperties": false,
                           "properties": {"entity": {"type": "string", "minLength": 1},
                                          "op": {"enum": ["read", "create", "update", "delete", "query", "persist"]},
                                          "key": {"type": ["string", "null"]}}}},
    "outcome": {"type": "object", "required": ["status", "code", "failed_step", "replay"],
                "additionalProperties": false,
                "properties": {"status": {"type": "integer", "minimum": 100, "maximum": 599},
                               "code": {"type": ["string", "null"]},
                               "failed_step": {"type": ["string", "null"]},
                               "replay": {"type": "boolean"}}},
    "duration_ms": {"type": "number", "minimum": 0}
  }
}
