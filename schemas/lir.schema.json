{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LNPP Semantic IR (LIR) document",
  "type": "object",
  "properties": {
    "lir_version": {
      "enum": [
        "0.1"
      ]
    },
    "module": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/nodeEntity"
          },
          {
            "$ref": "#/$defs/nodeService"
          },
          {
            "$ref": "#/$defs/nodeWorkflow"
          },
          {
            "$ref": "#/$defs/nodeEvent"
          },
          {
            "$ref": "#/$defs/nodeCapability"
          },
          {
            "$ref": "#/$defs/nodeRefinement"
          },
          {
            "$ref": "#/$defs/nodeBusinessRule"
          },
          {
            "$ref": "#/$defs/nodeValidation"
          },
          {
            "$ref": "#/$defs/nodeWorkflowStep"
          },
          {
            "$ref": "#/$defs/nodePipeline"
          },
          {
            "$ref": "#/$defs/nodeConcurrency"
          },
          {
            "$ref": "#/$defs/nodeGuard"
          },
          {
            "$ref": "#/$defs/nodeAssignment"
          },
          {
            "$ref": "#/$defs/nodeNetworkCall"
          },
          {
            "$ref": "#/$defs/nodeRepositoryCall"
          },
          {
            "$ref": "#/$defs/nodeCacheAccess"
          },
          {
            "$ref": "#/$defs/nodeTransaction"
          },
          {
            "$ref": "#/$defs/nodeAuthorization"
          },
          {
            "$ref": "#/$defs/nodeEventEmit"
          },
          {
            "$ref": "#/$defs/nodePolicy"
          },
          {
            "$ref": "#/$defs/nodeSecurity"
          },
          {
            "$ref": "#/$defs/nodePerformance"
          }
        ]
      }
    }
  },
  "required": [
    "lir_version",
    "module",
    "nodes"
  ],
  "additionalProperties": false,
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+)*$"
    },
    "nodeIdArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nodeId"
      }
    },
    "lineNumber": {
      "type": "integer",
      "minimum": 1
    },
    "meta": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "origin": {
          "type": "string",
          "pattern": "^(human|agent:.+)$"
        }
      },
      "additionalProperties": false
    },
    "fieldList": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "valueScalar": {
      "type": [
        "string",
        "number"
      ]
    },
    "baseTypeName": {
      "type": "string",
      "enum": [
        "UUID",
        "Money",
        "Email",
        "Phone",
        "Password",
        "Address",
        "Image",
        "File",
        "Currency",
        "GeoLocation",
        "Json",
        "Html",
        "Markdown",
        "Text",
        "Integer",
        "Decimal",
        "Boolean",
        "DateTime"
      ]
    },
    "facets": {
      "type": "object",
      "properties": {
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "pattern": {
          "type": "string"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "enum": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/valueScalar"
          }
        }
      },
      "additionalProperties": false
    },
    "nodeEntity": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "Entity"
          ]
        },
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "line": {
          "$ref": "#/$defs/lineNumber"
        },
        "children": {
          "$ref": "#/$defs/nodeIdArray"
        },
        "name": {
          "type": "string"
        },
        "fields": {
          "$ref": "#/$defs/fieldList"
        },
        "constraints": {
          "$ref": "#/$defs/nodeIdArray"
        }
      },
      "required": [
        "kind",
        "id",
        "name",
        "fields"
      ],
      "additionalProperties": false
    },
    "nodeService": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "Service"
          ]
        },
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "line": {
          "$ref": "#/$defs/lineNumber"
        },
        "children": {
          "$ref": "#/$defs/nodeIdArray"
        },
        "name": {
          "type": "string"
        },
        "requires": {
          "$ref": "#/$defs/nodeIdArray"
        },
        "constraints": {
          "$ref": "#/$defs/nodeIdArray"
        }
      },
      "required": [
        "kind",
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "nodeWorkflow": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "Workflow"
          ]
        },
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "line": {
          "$ref": "#/$defs/lineNumber"
        },
        "children": {
          "$ref": "#/$defs/nodeIdArray"
        },
        "name": {
          "type": "string"
        },
        "constraints": {
          "$ref": "#/$defs/nodeIdArray"
        }
      },
      "required": [
        "kind",
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "nodeEvent": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "Event"
          ]
        },
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "line": {
          "$ref": "#/$defs/lineNumber"
        },
        "name": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/fieldList"
        },
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/eventSourceEntity"
            },
            {
              "$ref": "#/$defs/eventSourceSchedule"
            }
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "eventSourceEntity": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/nodeId"
        },
        "on": {
          "enum": [
            "create",
            "update",
            "delete"
          ]
        }
      },
      "required": [
        "ref",
        "on"
      ],
      "additionalProperties": false
    },
    "eventSourceSchedule": {
      "type": "object",
      "properties": {
        "every": {
          "enum": [
            "daily"
          ]
        },
        "at": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "zone": {
          "enum": [
            "UTC"
          ]
        }
      },
      "required": [
        "every",
        "at",
        "zone"
      ],
      "additionalProperties": false
    },
    "nodeCapability": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "Capability"
          ]
        },
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "line": {
          "$ref": "#/$defs/lineNumber"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "nodeRefinement": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "Refinement"
          ]
        },
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "line": {
          "$ref": "#/$defs/lineNumber"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "base": {
          "$ref": "#/$defs/baseTypeName"
        },
        "facets": {
          "$ref": "#/$defs/facets"
        }
      },
      "required": [
        "kind",
        "id",
        "name",
        "base",
        "facets"
      ],
      "additionalProperties": false
    },
    "nodeBusinessRule": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "BusinessRule"
          ]
        },
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "line": {
          "$ref": "#/$defs/lineNumber"
        },
        "name": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "expression": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "name",
        "statement"
      ],
      "additionalProperties": false
    },
    "nodeValidation": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "Validation"
          ]
        },
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "line": {
          "$ref": "#/$defs/lineNumber"
        },
        "target": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "target",
        "rule"
      ],
      "additionalProperties": false
    },
    "nodeWorkflowStep": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "WorkflowStep"
          ]
        },
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "line": {
          "$ref": "#/$defs/lineNumber"
        },
        "children": {
          "$ref": "#/$defs/nodeIdArray"
        },
        "name": {
          "type": "string"
        },
        "constraints": {
          "$ref": "#/$defs/nodeIdArray"
        }
      },
      "required": [
        "kind",
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "nodePipeline": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "Pipeline"
          ]
        },
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "line": {
          "$ref": "#/$defs/lineNumber"
        },
        "children": {
          "$ref": "#/$defs/nodeIdArray"
        },
        "name": {
          "type": "string"
        },
        "constraints": {
          "$ref": "#/$defs/nodeIdArray"
        }
      },
      "required": [
        "kind",
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "nodeConcurrency": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "Concurrency"
          ]
        },
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "line": {
          "$ref": "#/$defs/lineNumber"
        },
        "children": {
          "$ref": "#/$defs/nodeIdArray"
        },
        "mode": {
          "enum": [
            "parallel"
          ]
        },
        "merge": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "mode"
      ],
      "additionalProperties": false
    },
    "nodeAssignment": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "Assignment"
          ]
        },
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "line": {
          "$ref": "#/$defs/lineNumber"
        },
        "target": {
          "type": "string"
        },
        "expression": {
          "type": "string"
        },
        "entity": {
          "$ref": "#/$defs/nodeId"
        }
      },
      "required": [
        "kind",
        "id",
        "target",
        "expression",
        "entity"
      ],
      "additionalProperties": false
    },
    "nodeGuard": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "Guard"
          ]
        },
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "line": {
          "$ref": "#/$defs/lineNumber"
        },
        "mode": {
          "enum": [
            "when",
            "until",
            "repeat"
          ]
        },
        "condition": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "children": {
          "$ref": "#/$defs/nodeIdArray"
        }
      },
      "required": [
        "kind",
        "id",
        "mode"
      ],
      "additionalProperties": false
    },
    "nodeNetworkCall": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "NetworkCall"
          ]
        },
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "line": {
          "$ref": "#/$defs/lineNumber"
        },
        "target": {
          "type": "string"
        },
        "protocol": {
          "enum": [
            "http",
            "grpc",
            "graphql"
          ]
        },
        "operation": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "target"
      ],
      "additionalProperties": false
    },
    "nodeRepositoryCall": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "RepositoryCall"
          ]
        },
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "line": {
          "$ref": "#/$defs/lineNumber"
        },
        "entity": {
          "$ref": "#/$defs/nodeId"
        },
        "operation": {
          "enum": [
            "create",
            "read",
            "update",
            "delete",
            "query"
          ]
        },
        "query": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "entity",
        "operation"
      ],
      "additionalProperties": false
    },
    "nodeCacheAccess": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "CacheAccess"
          ]
        },
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "line": {
          "$ref": "#/$defs/lineNumber"
        },
        "key": {
          "type": "string"
        },
        "operation": {
          "enum": [
            "get",
            "set",
            "invalidate"
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "key",
        "operation"
      ],
      "additionalProperties": false
    },
    "nodeTransaction": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "Transaction"
          ]
        },
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "line": {
          "$ref": "#/$defs/lineNumber"
        },
        "children": {
          "$ref": "#/$defs/nodeIdArray"
        },
        "isolation": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "nodeAuthorization": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "Authorization"
          ]
        },
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "line": {
          "$ref": "#/$defs/lineNumber"
        },
        "requirement": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "requirement"
      ],
      "additionalProperties": false
    },
    "nodeEventEmit": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "EventEmit"
          ]
        },
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "line": {
          "$ref": "#/$defs/lineNumber"
        },
        "event": {
          "$ref": "#/$defs/nodeId"
        },
        "payloadMap": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "event"
      ],
      "additionalProperties": false
    },
    "nodePolicy": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "Policy"
          ]
        },
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "line": {
          "$ref": "#/$defs/lineNumber"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "enum": [
                  "retry",
                  "rollback",
                  "timeout",
                  "parallel"
                ]
              },
              "value": {
                "$ref": "#/$defs/valueScalar"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "id",
        "rules"
      ],
      "additionalProperties": false
    },
    "nodeSecurity": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "Security"
          ]
        },
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "line": {
          "$ref": "#/$defs/lineNumber"
        },
        "mechanisms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "id",
        "mechanisms"
      ],
      "additionalProperties": false
    },
    "nodePerformance": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "Performance"
          ]
        },
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "line": {
          "$ref": "#/$defs/lineNumber"
        },
        "budgets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric": {
                "enum": [
                  "response",
                  "cache",
                  "parallel",
                  "prefetch",
                  "batch"
                ]
              },
              "value": {
                "$ref": "#/$defs/valueScalar"
              }
            },
            "required": [
              "metric"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "id",
        "budgets"
      ],
      "additionalProperties": false
    }
  }
}
